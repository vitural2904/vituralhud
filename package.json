{
  "name": "virtualhud-lol",
  "version": "1.1.0",
  "description": "Local League of Legends ban/pick and post-match overlay for OBS.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitural2904/virtualhud-lol.git"
  },
  "homepage": "https://github.com/vitural2904/virtualhud-lol#readme",
  "bugs": {
    "url": "https://github.com/vitural2904/virtualhud-lol/issues"
  },
  "keywords": ["league-of-legends", "obs", "overlay", "champ-select", "post-match", "lcu"],
  "type": "module",
  "scripts": {
    "assets:champions": "node scripts/fetch-champion-assets.mjs",
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run && vite build"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sinclair/typebox": "^0.34.41",
    "@vitejs/plugin-react": "5.0.4",
    "fastify": "5.8.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "3.2.7"
  }
}
